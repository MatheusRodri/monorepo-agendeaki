@startuml Dinamico-CriarAgendamento-01-Validacao
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Dynamic.puml

title Dinâmico — Criar agendamento (1/2): autenticação e validação
LAYOUT_TOP_DOWN()
hide stereotype
SHOW_LEGEND()

Person(cliente, "Cliente", "Solicita um horário.")
Container(frontend, "Frontend Web", "Next.js", "Envia a solicitação de agendamento.")
Container(api, "API", "Node.js / Express", "Valida a requisição e coordena a reserva.")
Container_Ext(auth, "Supabase Auth", "Autenticação", "Confirma a identidade do cliente.")
Component(reserva, "resolverReserva()", "Serviço de domínio", "Valida e resolve os dados do horário.")
ContainerDb(mysql, "MySQL", "MySQL 8", "Contém os dados da agenda.")

Rel_D(cliente, frontend, "Confirma horário")
Rel_D(frontend, api, "Envia POST /api/clientes/agendamentos")
Rel_D(api, auth, "Valida token com auth.getUser()")
Rel_D(api, mysql, "Abre transação e bloqueia o usuário")
Rel_D(api, reserva, "Solicita validação da reserva")
Rel_D(reserva, mysql, "Consulta serviço, profissional, horários e agenda")

@enduml
